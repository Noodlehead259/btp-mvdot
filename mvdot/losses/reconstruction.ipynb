   "source": [
    "import torch.nn as nn\n",
    "import torch.nn.functional as f\n",
    "\n",
    "\n",
    "class reconstruction_loss(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "    def forward(self, x, x_hat):\n",
    "        return f.mse_loss(\n",
    "            x_hat,\n",
    "            x,\n",
    "            reduction=\"sum\"\n",
    "        )"
   ]
  }
 ],
